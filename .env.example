# Awaaz Labs website environment variables.
# Copy to .env.local for local dev; set in Netlify for production.
# Every variable is optional: the site builds and runs with all unset.

# Canonical site origin. Used for metadataBase (OG/twitter URLs),
# sitemap.xml and JSON-LD. Unset: falls back to http://localhost:3000,
# which makes social-card URLs wrong in production. Set in prod.
NEXT_PUBLIC_SITE_URL=https://awaazlabs.io

# GA4 measurement ID (G-XXXXXXXXXX). Enables analytics and the
# conversion events (audit_submitted, call_booked, calculator_completed,
# demo_audio_played). Unset: no analytics scripts load at all.
NEXT_PUBLIC_GA_ID=

# Scheduler embed URL for /book-a-call (Cal.com or Calendly).
# Unset: the page shows an email/audit fallback instead of an iframe.
# call_booked fires on the scheduler's postMessage for both providers.
NEXT_PUBLIC_SCHEDULER_URL=

# Case study indexability gate. "true": /customers/advanzatech and
# /customers/sirius-solutions are indexable, in the sitemap and linked
# from the hub. Unset/other: pages render at their URLs for review but
# carry noindex,nofollow, are out of the sitemap, and the hub shows
# them as coming soon. Flip to "true" once client sign-off is recorded.
NEXT_PUBLIC_CASE_STUDIES_LIVE=

# Webhook that receives leak-audit form submissions (Make/Zapier/n8n).
# The webhook owns fulfillment: CRM row, confirmation email, and the
# 3-email post-audit sequence. Unset: submissions still succeed and are
# logged server-side, so no lead is ever lost.
LEAK_AUDIT_WEBHOOK_URL=
